# SAFINUM 2026 — Configuration de l'API locale souveraine
# IMPORTANT : AUCUN SECRET RÉEL NE DOIT ÊTRE COMMIS DANS CE FICHIER.

# Clé API pour moteur de traduction automatique (NMT / LLM distant optionnel)
TRANSLATION_API_KEY=""

# Délai maximum d'attente du moteur automatique en secondes (défaut : 2.0s)
TRANSLATION_TIMEOUT_SECONDS=2.0

# Origines CORS autorisées (séparées par une virgule)
ALLOWED_ORIGINS="https://safinum.cm,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://localhost:5173"

# Limites de sécurité DoS
MAX_BATCH_SIZE=100
MAX_TEXT_LENGTH=2000
